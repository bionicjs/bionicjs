{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./*"],
      "@bionicjs/core/server": ["./.bionicjs/server.ts"],
      "@bionicjs/api": ["./.bionicjs/api-client.ts"]
    }
  },
  "include": ["main.tsx", "app", "server", "ai", "jobs", ".bionicjs", "bionicjs.config.ts"]
}